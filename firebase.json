{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "README.md", "firestore.rules", "firestore.indexes.json", "functions/**", "tools/**"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(css|js|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    { "source": "functions", "codebase": "default", "ignore": ["node_modules", ".git"] }
  ]
}
